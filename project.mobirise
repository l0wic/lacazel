  "pages": {
    "studio.html": {
      "settings": {
        "title": "Studio d'architecture intérieure en Aveyron | Lacazel",
        "meta_descr": "Architecte d’intérieur en Aveyron. Formée à l’École Boulle, je conçois des espaces sur mesure, révélant l’identité et le caractère de chaque lieu.",
        "header_custom": "<link rel=\"canonical\" href=\"https://lacazel.fr/studio\" />\n<script type=\"application/ld+json\">\n[\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"ProfessionalService\",\n    \"@id\": \"https://lacazel.fr/#organization\",\n    \"name\": \"Lacazel\",\n    \"alternateName\": \"Lacazel Studio d'architecture intérieure\",\n    \"description\": \"Architecte d'intérieur en Aveyron, spécialisée dans la transformation de lieux existants. Des espaces fonctionnels et évolutifs pensés pour être vécus et accueillir.\",\n    \"url\": \"https://lacazel.fr/\",\n    \"logo\": \"https://lacazel.fr/assets/images/lczl-typo-01-f8f5f4-2.png\",\n    \"image\": \"https://lacazel.fr/assets/images/index-meta.jpg\",\n    \"areaServed\": {\n      \"@type\": \"AdministrativeArea\",\n      \"name\": \"Aveyron\"\n    },\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"3670 route de Golinhac\",\n      \"addressLocality\": \"Espeyrac\",\n      \"postalCode\": \"12140\",\n      \"addressRegion\": \"Occitanie\",\n      \"addressCountry\": \"FR\"\n    },\n    \"telephone\": \"+33-7-49-17-10-31\",\n \"openingHoursSpecification\": {\n    \"@type\": \"OpeningHoursSpecification\",\n    \"dayOfWeek\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"],\n    \"opens\": \"08:00\",\n    \"closes\": \"18:30\"\n  },\n    \"founder\": {\n      \"@type\": \"Person\",\n      \"name\": \"Emmanuelle Lépinay\",\n      \"jobTitle\": \"Architecte d'intérieur\",\n      \"sameAs\": [\n        \"https://fr.linkedin.com/in/emmanuelle-l%C3%A9pinay\"\n      ]\n    },\n    \"sameAs\": [\n      \"https://www.instagram.com/lacazel.studio\",\n      \"https://www.facebook.com/share/1PJD9tw67J\",\n      \"https://fr.linkedin.com/in/emmanuelle-l%C3%A9pinay\"\n    ]\n  },\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"WebSite\",\n    \"@id\": \"https://lacazel.fr/#website\",\n    \"url\": \"https://lacazel.fr/\",\n    \"name\": \"Lacazel : Architecte d'intérieur en Aveyron\",\n    \"publisher\": {\n      \"@id\": \"https://lacazel.fr/#organization\"\n    },\n    \"inLanguage\": \"fr-FR\"\n  },\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"WebPage\",\n    \"@id\": \"https://lacazel.fr/#webpage\",\n    \"url\": \"https://lacazel.fr/studio\",\n    \"name\": \"Studio d'architecture intérieure en Aveyron | Lacazel\",\n    \"description\": \"Architecte d’intérieur en Aveyron. Formée à l’École Boulle, je conçois des espaces sur mesure, révélant l’identité et le caractère de chaque lieu.\",\n    \"isPartOf\": {\n      \"@id\": \"https://lacazel.fr/#website\"\n    },\n    \"about\": {\n      \"@id\": \"https://lacazel.fr/#organization\"\n    },\n    \"primaryImageOfPage\": \"https://lacazel.fr/assets/images/cabinet-architecte-interieur-aveyron.webp\",\n    \"inLanguage\": \"fr-FR\",\n    \"breadcrumb\": {\n      \"@id\": \"https://lacazel.fr/#breadcrumb\"\n    }\n  },\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"BreadcrumbList\",\n    \"@id\": \"https://lacazel.fr/#breadcrumb\",\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 1,\n        \"name\": \"Accueil\",\n        \"item\": \"https://lacazel.fr/\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 2,\n        \"name\": \"Studio d'architecture intérieure en Aveyron\",\n        \"item\": \"https://lacazel.fr/studio\"\n      }\n    ]\n  }\n]\n</script>",
