            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            "header-menu-item": {
              "color": "#e0d0c1",
              "text-align": "center"
            },
            ".title-wrapper": {
              "display": "flex",
              "align-items": "center",
              "transform-origin": "center",
              "margin-bottom": "20px",
              "width": "50%"
            },
            ".img-wrapper": {
              "text-align": "center",
              "margin": "0",
              "padding": "0"
            },
            ".img-wrapper img": {
              "align-items": "center",
              "max-width": "10%",
              "padding": "30px",
              "height": "auto",
              "display": "inline-block"
            },
            "@media (max-width: 768px)": {
              ".img-wrapper img": {
                "max-width": "30%",
                "padding": "15px"
              }
            },
            "P": {
              "text-align": "center",
              "color": "#e0d0c1"
            }
