                    "margin-bottom": "4px !important"
                  }
                }
              }
            },
            ".content-wrap": {
              "min-height": "110px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "holidaym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 holidaym5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top=\"\" global=\"\" once=\"menu\" not-draggable=\"\" position-absolute=\"\">\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked=\"\">\n        <input type=\"range\" title=\"Logo Size\" inline=\"\" name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked=\"\">\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#3a352b\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\" selected=\"\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#c10b02\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked=\"\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#3a352b\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#f7f9f9\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://lacazel.fr\">\n                        <img src=\"@PROJECT_PATH@/assets/images/lczl-typo-01-1e1b1d-1.webp\" alt=\"Lacazel architecte d'intérieur en aveyron\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons=\"\" mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-success\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">L A C A Z E L</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu=\"\" class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish &amp;&amp; !showBrand &amp;&amp; !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"https://lacazel.fr/accompagnements\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ACCOMPAGNEMENTS</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"https://lacazel.fr/studio\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">STUDIO</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"https://lacazel.fr/projets\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PROJETS</a>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"https://lacazel.fr/contact\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CONTACT</a></li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">nous contacter</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_cid": "vhsrkVTeR3",
          "_anchor": "menu01-7t",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- ========== HERO RODEZ ========== -->\n<section class=\"hero-rodez\">\n  <div class=\"hero-content\">\n    <div class=\"badge-local\">✨ Sur le territoire ruthénois</div>\n    <h1 style=\"font-family:'Playfair Display',serif; font-size:3.5rem; margin-bottom:1rem;\">Architecte d'intérieur <br><strong>Rodez</strong></h1>\n    <p style=\"font-size:1.1rem; margin:1.5rem auto; max-width:600px;\">Valoriser le patrimoine ruthénois et révéler le potentiel de chaque lieu : habitations, résidences secondaires, gîtes de charme. Un accompagnement sur mesure en plein cœur de l'Aveyron.</p>\n    <a href=\"#contact\" class=\"btn btn-white-outline\" style=\"padding:0.8rem 2rem;\">PRENDRE RDV · DEVIS GRATUIT</a>\n  </div>\n</section>\n\n<!-- ========== INTRODUCTION ========== -->\n<section class=\"section-padding\" style=\"background:#f8f5f4;\">\n  <div class=\"container\">\n    <div class=\"row\" style=\"align-items:center;\">\n      <div class=\"col-lg-5\">\n        <img src=\"https://lacazel.fr/assets/images/img-9082.webp\" alt=\"Architecte d'intérieur Rodez\" class=\"w-100\" style=\"border-radius:20px;\">\n      </div>\n      <div class=\"col-lg-7\">\n        <h2 style=\"font-family:'Playfair Display',serif; font-size:2rem;\">Habiter la cité historique <em>avec modernité</em></h2>\n        <p style=\"margin:1rem 0; font-size:1rem;\">Rodez possède un héritage architectural remarquable : hôtels particuliers, appartements de ville, maisons de caractère. Mon approche respecte l'âme des lieux tout en y insufflant fonctionnalité et lumière. Que ce soit pour repenser un espace de vie, créer une chambre d'hôtes ou optimiser un pied-à-terre, je vous accompagne pour que votre intérieur devienne une évidence.</p>\n        <a href=\"https://lacazel.fr/studio\" class=\"btn btn-secondary-outline\">DÉCOUVRIR L'APPROCHE STUDIO</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ========== 3 PRESTATIONS ========== -->\n<section class=\"section-padding\">\n  <div class=\"container\">\n    <div class=\"text-center\" style=\"margin-bottom:3rem;\">\n      <h2 style=\"font-family:'Playfair Display',serif; font-size:2rem;\">Mes <em>accompagnements</em> à Rodez</h2>\n      <p>Trois niveaux de mission, du diagnostic à la création complète d'ambiance.</p>\n    </div>\n    <div class=\"row\">\n      <div class=\"col-md-6 col-lg-4\">\n        <div class=\"card-service\">\n          <div class=\"icon-large\"><i class=\"fas fa-lightbulb\"></i></div>\n          <h3 style=\"font-family:'Playfair Display',serif;\"><em>·</em> Inspiration</h3>\n          <p><strong>Regard extérieur &nbsp; conseil</strong></p>\n          <p>Une à deux visites à Rodez ou à distance pour analyser votre espace, débloquer une situation ou clarifier vos envies d'aménagement.</p>\n        </div>\n      </div>\n      <div class=\"col-md-6 col-lg-4\">\n        <div class=\"card-service\">\n          <div class=\"icon-large\"><i class=\"fas fa-drafting-compass\"></i></div>\n          <h3 style=\"font-family:'Playfair Display',serif;\"><em>·</em> Transformation</h3>\n          <p><strong>Conception globale jusqu'aux travaux</strong></p>\n          <p>Organisation des espaces, choix esthétiques, plans 2D, visuels 3D. Possibilité de suivi de chantier pour les projets de rénovation.</p>\n        </div>\n      </div>\n      <div class=\"col-md-6 col-lg-4\">\n        <div class=\"card-service\">\n          <div class=\"icon-large\"><i class=\"fas fa-crown\"></i></div>\n          <h3 style=\"font-family:'Playfair Display',serif;\"><em>·</em> Valorisation</h3>\n          <p><strong>Expérience clé en main</strong></p>\n          <p>Projets de gîtes, chambres d'hôtes ou lieux d'accueil : scénographie, mobilier sur mesure, identité visuelle et shooting pro.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ========== ZONES D'INTERVENTION ========== -->\n<section class=\"section-padding\" style=\"background:#f9f7f3;\">\n  <div class=\"container\">\n    <div class=\"info-box\">\n      <h2 style=\"font-family:'Playfair Display',serif; font-size:1.8rem;\">Interventions <em>dans tout Rodez</em> et le Grand Rodez</h2>\n      <p style=\"margin-top:1rem;\">Je me déplace régulièrement dans l'hypercentre, le quartier de Bourran, St-Félix, Layoule, mais aussi les communes voisines : <strong>Onet-le-Château, Sébazac-Concourès, Le Monastère, Olemps, Druelle</strong>.</p>\n      <div class=\"row\" style=\"margin-top:1.5rem;\">\n        <div class=\"col-md-4\"><i class=\"fas fa-check-circle\" style=\"color:#b59d7a;\"></i> Rue Béteille &nbsp; quartier historique</div>\n        <div class=\"col-md-4\"><i class=\"fas fa-check-circle\" style=\"color:#b59d7a;\"></i> Secteur de la gare</div>\n        <div class=\"col-md-4\"><i class=\"fas fa-check-circle\" style=\"color:#b59d7a;\"></i> Maisons avenue Victor Hugo</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ========== POURQUOI UN ARCHITECTE LOCAL ========== -->\n<section class=\"section-padding\">\n  <div class=\"container\">\n    <div class=\"row\" style=\"align-items:center;\">\n      <div class=\"col-lg-7\">\n        <h2 style=\"font-family:'Playfair Display',serif; font-size:2rem;\">Une architecte <em>du territoire</em>, à votre écoute</h2>\n        <p style=\"margin:1rem 0;\">Basée entre Rodez et Espalion, je connais les spécificités des logements ruthénois : épaisseur des murs en pierre, hauteur sous plafond, exigences des bâtiments anciens. Mon expérience à l'École Boulle et dans des agences parisiennes m'apporte une rigueur technique, tandis que mon ancrage local garantit une relation de confiance.</p>\n        <div class=\"row\" style=\"margin-top:1rem;\">\n          <div class=\"col-md-4\"><i class=\"fas fa-ruler-combined\"></i> Permis &nbsp; PLU</div>\n          <div class=\"col-md-4\"><i class=\"fas fa-hard-hat\"></i> Artisans locaux</div>\n          <div class=\"col-md-4\"><i class=\"fas fa-euro-sign\"></i> Devis transparent</div>\n        </div>\n      </div>\n      <div class=\"col-lg-5\">\n        <img src=\"https://lacazel.fr/assets/images/studio-architecture-interieur-studio-design.webp\" alt=\"Atelier architecture intérieure\" class=\"w-100\" style=\"border-radius:20px;\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ========== FORMULAIRE DE CONTACT ========== -->\n<section class=\"section-padding\" id=\"contact\" style=\"background:#f8f5f4;\">\n  <div class=\"container\">\n    <div class=\"info-box\" style=\"background:#fff; box-shadow:0 10px 30px rgba(0,0,0,0.05);\">\n      <div class=\"text-center\">\n        <h2 style=\"font-family:'Playfair Display',serif; font-size:2rem;\">Demande de <em>devis gratuit</em> – Rodez</h2>\n        <p>Sans engagement, étude personnalisée de votre projet dans les 48h.</p>\n      </div>\n      <form action=\"https://formspree.io/f/xeoqrgwz\" method=\"POST\" style=\"max-width:700px; margin:2rem auto 0;\">\n        <div class=\"row\">\n          <div class=\"col-md-4\"><input type=\"text\" class=\"form-control\" name=\"nom\" placeholder=\"Nom &amp; prénom\" required=\"\"></div>\n          <div class=\"col-md-4\"><input type=\"email\" class=\"form-control\" name=\"email\" placeholder=\"Email\" required=\"\"></div>\n          <div class=\"col-md-4\"><input type=\"tel\" class=\"form-control\" name=\"telephone\" placeholder=\"Téléphone\"></div>\n        </div>\n        <div style=\"margin-top:1rem;\">\n          <input type=\"text\" class=\"form-control\" name=\"ville\" value=\"Rodez\" placeholder=\"Commune d'intervention\">\n        </div>\n        <div style=\"margin-top:1rem;\">\n          <textarea class=\"form-control\" name=\"message\" rows=\"3\" placeholder=\"Décrivez votre projet (type de bien, surface, travaux envisagés...)\" required=\"\"></textarea>\n        </div>\n        <div style=\"margin-top:1.5rem; text-align:center;\">\n          <button type=\"submit\" class=\"btn btn-primary\" style=\"padding:0.8rem 2.5rem;\">Envoyer ma demande →</button>\n        </div>\n        <p style=\"text-align:center; margin-top:1rem; font-size:0.8rem;\">Vos données restent confidentielles. Réponse sous 2 jours ouvrés.</p>\n      </form>\n      <hr style=\"margin:1.5rem 0;\">\n      <div class=\"text-center\">\n        <p><i class=\"fas fa-phone-alt\"></i> <strong>07 49 17 10 31</strong> &nbsp;|&nbsp; <i class=\"far fa-envelope\"></i> contact@lacazel.fr</p>\n        <p style=\"font-size:0.8rem;\">🔒 *Tarifs conçus à l'avance : consultation à partir de 250€, accompagnement global sur devis. Intervention rapide sur Rodez.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ========== CTA FINAL ========== -->\n<section style=\"background:#2c3e2f; color:#fff; padding:3rem 2rem; text-align:center;\">\n  <h2 style=\"font-family:'Playfair Display',serif; font-size:2rem;\">Transformez votre intérieur à Rodez <br>avec un regard <em>authentique &nbsp; sur mesure</em></h2>\n  <div style=\"margin-top:1.5rem;\">\n    <a href=\"tel:+33749171031\" class=\"btn btn-white-outline\" style=\"margin:0 0.5rem;\">APPELER UN ARCHITECTE LOCAL</a>\n    <a href=\"https://lacazel.fr/contact\" class=\"btn\" style=\"background:#fff; color:#2c3e2f; margin:0 0.5rem;\">CONTACT &nbsp; DEVIS</a>\n  </div>\n</section>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
